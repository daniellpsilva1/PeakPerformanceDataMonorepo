{
  "schema_version": 1,
  "repo_id": "portfolio",
  "doc_root": "docs",
  "profile": "application",
  "tooling_version": "0.1.0",
  "managed": {
    "include": ["**/*.md", "**/*.mdx"]
  },
  "historical": [],
  "excluded": ["AGENTS.md"],
  "source_mappings": [],
  "dependencies": [],
  "commands": [
    {"name": "check", "command": "node .devin/docs-tooling/src/cli.mjs check --repo .", "safety_class": "local-read"},
    {"name": "catalog", "command": "node .devin/docs-tooling/src/cli.mjs catalog --repo . --check", "safety_class": "local-read"},
    {"name": "test", "command": "node --test .devin/docs-tooling/test/*.test.mjs", "safety_class": "local-read"}
  ],
  "exceptions": []
}
