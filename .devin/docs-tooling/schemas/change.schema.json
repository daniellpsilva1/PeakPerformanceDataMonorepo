{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Change record",
  "type": "object",
  "required": ["id", "requirements"],
  "properties": {
    "id": {"type": "string"},
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "implementation_state"],
        "properties": {
          "id": {"type": "string"},
          "description": {"type": "string"},
          "acceptance": {"type": "string"},
          "risk": {"type": "string", "enum": ["low", "medium", "high"]},
          "implementation_state": {"type": "string", "enum": ["proposed", "observed", "verified", "gap", "not_applicable"]},
          "design_refs": {"type": "array", "items": {"type": "string"}},
          "source_refs": {"type": "array"},
          "test_refs": {"type": "array"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "gaps": {"type": "string"}
        }
      }
    }
  },
  "additionalProperties": false
}
